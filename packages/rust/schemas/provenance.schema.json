{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.openakb.org/v1/provenance.schema.json",
  "title": "OpenAKB provenance sidecar",
  "description": "Per-section claim-level provenance sidecar (spec §4.4). One sidecar per section. Cross-file consistency (section_id and source_ids resolving into the descriptor) is checked by the validator, not this schema.",
  "type": "object",
  "required": ["section_id", "claims"],
  "properties": {
    "$schema": { "type": "string", "format": "uri", "pattern": "^https://schema\\.openakb\\.org/v1(\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?/provenance\\.schema\\.json$" },
    "section_id": { "$ref": "#/$defs/typedId" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "source_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/typedId" } },
          "locator": {
            "type": "object",
            "properties": {
              "quote": { "type": "string", "minLength": 1 },
              "page": { "type": "integer", "minimum": 0 },
              "anchor": { "type": "string" },
              "x": { "$ref": "#/$defs/extensions" }
            }
          },
          "x": { "$ref": "#/$defs/extensions" }
        }
      }
    }
  },
  "$defs": {
    "typedId": { "type": "string", "pattern": "^(?:[Ss][Ee][Cc]|[Ss][Rr][Cc])-[0-9A-Za-z]{6}$" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "additionalProperties": { "type": "object" }
    }
  }
}
